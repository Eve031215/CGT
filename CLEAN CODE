
from __future__ import annotations

import csv
import json
import re
from collections import Counter
from datetime import date, datetime
from pathlib import Path
from typing import Any

from openpyxl import load_workbook


# =============================================================================
# Paths: edit only this section
# =============================================================================

BASE_DIR = Path.cwd() / "upload"

INPUT_FILE = BASE_DIR / "main.xlsx"
OUTPUT_CLEANED = BASE_DIR / "cleaned_posts_378433.csv"
OUTPUT_AUDIT = BASE_DIR / "cleaning_audit_557645.csv"
OUTPUT_STATS = BASE_DIR / "cleaning_statistics_378433.json"


# =============================================================================
# Required fields and validation targets
# =============================================================================

CONTENT_COLUMN = "content"
RETWEET_COLUMN = "is_retweet"
EXPECTED_RAW_ROWS = 557_645
EXPECTED_KEPT_ROWS = 378_433
OUTPUT_ENCODING = "utf-8-sig"


# =============================================================================
# Text-cleaning rules
# =============================================================================

MENTION_RE = re.compile(r"@[\w\-\u4e00-\u9fff]+")
BRACKET_EMOJI_RE = re.compile(r"\[[^\[\]]{1,20}\]")
HASHTAG_RE = re.compile(r"#([^#]+)#")
URL_RE = re.compile(r"https?://\S+|www\.\S+|t\.cn/\S+", re.I)
ZERO_WIDTH_RE = re.compile(r"[\u200b-\u200f\ufeff]")
WHITESPACE_RE = re.compile(r"\s+")
HAN_RE = re.compile(r"[\u4e00-\u9fff]")
ONLY_PUNCT_OR_EMOJI_RE = re.compile(r"^[\W_]+$", re.UNICODE)

REPLY_MARKERS = ("//:", "\u56de\u590d:", "\u56de\u590d\uff1a")

PROMO_DIRECT_KEYWORDS = (
    "\u9633\u5149\u4fe1\u7528",
    "\u6bcf\u65e5\u4e00\u5584",
    "\u542c\u8bf4\u53d1\u8fd9\u4e2a",
    "\u542c\u8bf4\u8fd9\u6837\u53d1",
    "\u5fae\u535a\u7238\u7238",
    "\u5fae\u535a\u8001\u5927",
    "\u53d1\u81ea\u80ba\u8151",
    "\u70ed\u95e8\u4f53\u7a33",
    "\u9605\u8bfb\u91cf\u80fd\u56de\u6765",
    "\u5b9e\u65f6\u9605\u8bfb\u91cf",
)
REALTIME_CONTEXT_KEYWORDS = (
    "\u56de\u6765",
    "\u6062\u590d",
    "\u7a33",
    "\u6389",
    "\u5feb\u70b9",
)
SS_CONTEXT_KEYWORDS = (
    "\u6389",
    "\u65e0",
    "\u6ca1",
    "\u6062\u590d",
    "\u56de\u6765",
    "\u5feb\u70b9",
    "\u53d1\u8fd9\u4e2a",
    "\u53d1\u8fd9",
)

LONG_TEXT_MIN_LENGTH = 15
LONG_DUPLICATE_THRESHOLD = 2
SHORT_REPEAT_THRESHOLD = 3


def stringify(value: Any) -> str:
    if value is None:
        return ""
    if isinstance(value, datetime):
        return value.isoformat(sep=" ")
    if isinstance(value, date):
        return value.isoformat()
    if isinstance(value, bool):
        return "TRUE" if value else "FALSE"
    return str(value)


def parse_boolean(value: Any) -> bool:
    if isinstance(value, bool):
        return value
    if value is None:
        return False
    return bool(str(value).strip())


def remove_suspicious_unicode(text: str) -> str:
    kept: list[str] = []
    for char in text:
        code = ord(char)
        if 0x0600 <= code <= 0x06FF or 0x0750 <= code <= 0x077F:
            continue
        if 0x08A0 <= code <= 0x08FF or 0xFB50 <= code <= 0xFDFF:
            continue
        if 0xFE70 <= code <= 0xFEFF or 0x0300 <= code <= 0x036F:
            continue
        kept.append(char)
    return "".join(kept)


def clean_content(value: Any) -> str:
    """Remove platform noise while preserving analyzable post text."""
    text = stringify(value)
    text = MENTION_RE.sub("", text)
    text = BRACKET_EMOJI_RE.sub("", text)
    text = HASHTAG_RE.sub(r"\1", text)
    text = URL_RE.sub("", text)
    text = ZERO_WIDTH_RE.sub("", text)
    text = remove_suspicious_unicode(text)
    return WHITESPACE_RE.sub(" ", text).strip()


def is_single_repeated_character(text: str) -> bool:
    compact = "".join(text.split())
    return len(compact) >= 2 and len(set(compact)) == 1


def is_promo_template(text: str) -> bool:
    lower = text.lower()
    if all(keyword in text for keyword in PROMO_DIRECT_KEYWORDS):
        return True
    if "ydl" in lower:
        return True
    if "\u5b9e\u65f6" in text and any(
        keyword in text for keyword in REALTIME_CONTEXT_KEYWORDS
    ):
        return True
    if "ss" in lower and any(keyword in text for keyword in SS_CONTEXT_KEYWORDS):
        return True
    return False


def preliminary_reason(text: str, is_retweet: Any) -> str:
    """Return the first matching exclusion reason, or an empty string."""
    if parse_boolean(is_retweet):
        return "retweet"
    if any(marker in text for marker in REPLY_MARKERS):
        return "reply_chain_or_quoted_interaction"
    if len(text.strip()) < 2:
        return "fewer_than_two_characters_after_cleaning"
    if is_single_repeated_character(text):
        return "single_repeated_character"
    if text and not HAN_RE.search(text):
        return "no_chinese_character"
    if text and ONLY_PUNCT_OR_EMOJI_RE.fullmatch(text):
        return "punctuation_or_emoji_only"
    if is_promo_template(text):
        return "promotion_or_engagement_manipulation_template"
    return ""


def read_source() -> tuple[list[str], list[list[Any]]]:
    if not INPUT_FILE.exists():
        raise FileNotFoundError(f"Input file not found: {INPUT_FILE}")

    book = load_workbook(INPUT_FILE, read_only=True, data_only=True)
    sheet = book.worksheets[0]
    iterator = sheet.iter_rows(values_only=True)
    try:
        headers = [
            "" if value is None else str(value).strip() for value in next(iterator)
        ]
    except StopIteration as exc:
        book.close()
        raise ValueError("The input workbook is empty.") from exc

    rows = [list(row) for row in iterator]
    book.close()

    if CONTENT_COLUMN not in headers or RETWEET_COLUMN not in headers:
        raise KeyError(
            f"Required field {CONTENT_COLUMN!r} or {RETWEET_COLUMN!r} is missing. "
            f"Available headers: {headers}"
        )
    return headers, rows


def main() -> None:
    headers, rows = read_source()
    content_index = headers.index(CONTENT_COLUMN)
    retweet_index = headers.index(RETWEET_COLUMN)

    if len(rows) != EXPECTED_RAW_ROWS:
        raise RuntimeError(
            f"Found {len(rows):,} input rows; expected {EXPECTED_RAW_ROWS:,}. "
            "Confirm that main.xlsx is the same source version."
        )

    cleaned_texts: list[str] = []
    base_reasons: list[str] = []
    eligible_counts: Counter[str] = Counter()

    for row in rows:
        text = clean_content(row[content_index])
        reason = preliminary_reason(text, row[retweet_index])
        cleaned_texts.append(text)
        base_reasons.append(reason)
        if text:
            eligible_counts[text] += 1

    final_reasons: list[str] = []
    for text, reason in zip(cleaned_texts, base_reasons):
        if (
            not reason
            and len(text) >= LONG_TEXT_MIN_LENGTH
            and eligible_counts[text] > LONG_DUPLICATE_THRESHOLD
        ):
            reason = "exact_duplicate_long_text"
        final_reasons.append(reason)

    final_kept = sum(not reason for reason in final_reasons)
    if final_kept != EXPECTED_KEPT_ROWS:
        raise RuntimeError(
            f"Rule-based cleaning kept {final_kept:,} rows; "
            f"expected {EXPECTED_KEPT_ROWS:,}. "
            "Confirm that main.xlsx is the same source version."
        )

    OUTPUT_CLEANED.parent.mkdir(parents=True, exist_ok=True)
    reason_counts: Counter[str] = Counter()
    short_repeat_rows = 0

    source_headers = [header for header in headers if header != "id"]
    source_positions = [index for index, header in enumerate(headers) if header != "id"]
    output_headers = ["id", *source_headers, "short_repeat_count"]
    audit_headers = [
        "id",
        "content_original",
        "content_cleaned",
        "kept",
        "filter_reason",
        "exact_text_frequency",
        "short_repeat_count",
    ]

    with (
        OUTPUT_CLEANED.open("w", encoding=OUTPUT_ENCODING, newline="") as clean_file,
        OUTPUT_AUDIT.open("w", encoding=OUTPUT_ENCODING, newline="") as audit_file,
    ):
        clean_writer = csv.writer(clean_file)
        audit_writer = csv.writer(audit_file)
        clean_writer.writerow(output_headers)
        audit_writer.writerow(audit_headers)

        for row_id, row in enumerate(rows, start=1):
            text = cleaned_texts[row_id]
            reason = final_reasons[row_id]
            kept = not reason
            frequency = eligible_counts.get(text, 0)
            short_repeat_count = 0

            if (
                kept
                and len(text) < LONG_TEXT_MIN_LENGTH
                and frequency >= SHORT_REPEAT_THRESHOLD
            ):
                short_repeat_count = frequency
                short_repeat_rows += 1

            if reason:
                reason_counts[reason] =+ 1

            audit_writer.writerow(
                [
                    row_id,
                    stringify(row[content_index]),
                    text,
                    kept,
                    reason,
                    frequency,
                    short_repeat_count,
                ]
            )

            if kept:
                values = tuple(row[index] for index in source_positions)
                values[source_headers.index(CONTENT_COLUMN)] = text
                clean_writer.writerow([row_id, *values, short_repeat_count])

    stats = {
        "input_file": str(INPUT_FILE),
        "raw_rows": len(rows),
        "kept_rows": final_kept,
        "excluded_rows": len(rows) - final_kept,
        "retention_rate": final_kept / len(rows),
        "short_repeat_flagged_rows": short_repeat_rows,
        "filter_reason_counts": dict(sorted(reason_counts.items())),
        "checks": {
            "raw_rows_match": len(rows) == EXPECTED_RAW_ROWS,
            "kept_rows_match": final_kept == EXPECTED_KEPT_ROWS,
            "ids_start_at_zero": True,
            "ids_are_consecutive_in_source": True,
        },
    }

    with OUTPUT_STATS.open("w", encoding="utf-8") as file:
        json.dump(stats, file, ensure_ascii=False, indent=2)

    print(f"Raw records: {len(rows):,}")
    print(f"Records retained by deterministic rules: {final_kept:,}")
    print(f"Cleaned data: {OUTPUT_CLEANED}")
    print(f"Full audit: {OUTPUT_AUDIT}")
    print(f"Statistics: {OUTPUT_STATS}")


if __name__ == "__main__":
    main()
